# Copy to .env and adjust. The service reads these on each run.

# LLM provider: ollama (local, default) | claude | openai
LLM_PROVIDER=ollama

# --- MODEL SELECTION for extraction (EFT-10) --------------------------------
# Extraction needs strict JSON, not reasoning. Prefer a fast INSTRUCT model and
# AVOID "reasoning"/"thinking" variants (e.g. *-thinking, qwen3.5-*-a10b,
# deepseek-r1): they spend the token budget on hidden chain-of-thought, which
# truncates the JSON and causes "no JSON object found" failures. Recommended:
#   NVIDIA (OpenAI-compatible): qwen/qwen2.5-72b-instruct | meta/llama-3.3-70b-instruct
#   Ollama (local):             qwen2.5:14b-instruct  (or qwen2.5:3b for speed)
#   OpenAI:                     gpt-4o | gpt-4o-mini
#   Claude:                     claude-opus-4-8  (adaptive thinking is fine here)
# For any OpenAI-compatible endpoint, keep OPENAI_JSON_MODE=auto (below) so
# response_format enforces valid JSON server-side.

# --- Ollama (LOCAL/LAN, default — no API key) -------------------------------
# Ollama server on the LAN host. qwen2.5:3b is fast (use CHUNK_TOKENS~600);
# qwen2.5:14b is higher quality but slower.
OLLAMA_BASE_URL=http://192.168.100.158:11434
OLLAMA_MODEL=qwen2.5:3b
# For a server on the same machine, use http://localhost:11434 instead.

# --- Claude (cloud, recommended for quality) --------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI (cloud, alternative) --------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional: any OpenAI-compatible endpoint (NVIDIA NIM, Together, Groq, vLLM…).
# Blank = the real OpenAI API. Example (NVIDIA-hosted, instruct model):
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#   OPENAI_API_KEY=nvapi-...        # put your real key here, never commit it
#   OPENAI_MODEL=qwen/qwen2.5-72b-instruct   # instruct, NOT a *-thinking variant
OPENAI_BASE_URL=

# --- Extraction reliability (EFT) -------------------------------------------
# JSON mode for OpenAI-compatible endpoints: auto (probe + cache) | force | off.
OPENAI_JSON_MODE=auto
# Per-call token budgets (base; escalated 1x/1.5x/2x on retry).
EXTRACT_MAX_TOKENS=8000
BRIEF_MAX_TOKENS=6000
# Log successful (chunk -> extraction) pairs for future fine-tuning (EFT-11).
# Off by default; writes deduped JSON records to EXTRACTION_LOG_DIR.
LOG_EXTRACTIONS=false
EXTRACTION_LOG_DIR=data/extraction_log

# Ingestion guardrails
MAX_FILE_BYTES=104857600   # 100 MB
MAX_PAGES=500
MIN_TEXT_CHARS=40
# OCR quality gate (ING-06): mean word confidence (0-100) below this flags the
# document low_confidence and the UI shows a scan-quality banner.
OCR_MIN_CONFIDENCE=70
# Layout parsing (HAR-01/02): column-aware extraction for 2-column PDFs (avoids
# cross-column bleed) and figure/table caption extraction.
LAYOUT_COLUMNS=true
EXTRACT_CAPTIONS=true

# Chunking (prose, token estimate). 600 suits the 3b model; raise to ~1200 for
# qwen2.5:14b or a cloud model.
CHUNK_TOKENS=600
CHUNK_OVERLAP=100
# Rate-limit mitigation for metered/free endpoints (e.g. NVIDIA free tier):
# raise CHUNK_TOKENS (fewer chunks = fewer calls), add a per-call throttle, and
# let the SDK back off more on 429/5xx. Example free-tier-friendly settings:
#   CHUNK_TOKENS=1800   CHUNK_THROTTLE_MS=1500   LLM_MAX_RETRIES=6
CHUNK_THROTTLE_MS=0
LLM_MAX_RETRIES=5
# Parallel chunk extraction (EXT-04 / HAR-03 latency). 1 = sequential (safe).
# Raise (e.g. 4-8) for providers that allow concurrent requests to cut extraction
# time; keep at 1 for rate-limited/free tiers (or pair with CHUNK_THROTTLE_MS).
EXTRACT_CONCURRENCY=1

# Generate the executive Brief after building the graph (one extra LLM call).
GENERATE_BRIEF=true

# --- Auth + DB (Sprint 1a) ---
# In Docker, docker-compose sets DATABASE_URL to the `db` service. For local runs:
# DATABASE_URL=postgresql+psycopg2://kb:kb@localhost:5432/kb
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
# Refresh cookie is HttpOnly always. In production (HTTPS) set COOKIE_SECURE=true.
COOKIE_SECURE=false         # true = only sent over HTTPS (production)
COOKIE_SAMESITE=lax         # lax (same-site) | none (cross-site; auto-forces Secure)
# First admin (seeded only when the users table is empty):
ADMIN_EMAIL=admin@knowledgebook.local
ADMIN_PASSWORD=admin12345

# --- Subscription plans (PAY-01/02/03) ---
# Monthly document quota per consumer plan (0 = unlimited). Admins are exempt.
PLAN_FREE_DOCS=2
PLAN_PRO_DOCS=20
PLAN_SCHOLAR_DOCS=60
# Concept-map cap on the Free tier (0 = uncapped).
PLAN_FREE_CONCEPTS=10
# Value ladder (RC-20): minimum plan for LLM-synthesized chat when CHAT_MODE=llm.
# Free plans below this get zero-LLM retrieval chat. Set to "free" on-prem to
# give everyone LLM chat regardless of plan. Admins always get LLM.
CHAT_LLM_MIN_PLAN=pro

# --- Cost ledger + cap (EXT-02) ---
# Per-document hard cost cap in USD (0 = disabled). Local/free models accrue $0.
MAX_DOC_COST_USD=2.0
# Idempotent chunk cache (EXT-03): reuse a chunk's extraction on re-process/retry
# instead of re-calling the LLM. Redis-backed, fail-open.
CHUNK_CACHE_ENABLED=true
CHUNK_CACHE_TTL_DAYS=30

# --- Semantic retrieval embeddings (RC-14) ---
# Blank = OFF (retrieval stays lexical; nothing changes). Set a model to enable
# meaning-based chat retrieval. Uses an EMBEDDING model (not a chat LLM).
#   ollama:  EMBEDDING_MODEL=nomic-embed-text   (pull it on the Ollama host first)
#   openai:  EMBEDDING_PROVIDER=openai  EMBEDDING_MODEL=text-embedding-3-small
# Documents processed BEFORE enabling won't have vectors until re-processed.
EMBEDDING_MODEL=
EMBEDDING_PROVIDER=ollama
EMBEDDING_SIM_THRESHOLD=0.55
# Optional price override, USD per 1M tokens: model:in/out,model:in/out
# LLM_PRICES_USD=claude-opus-4-8:15/75,gpt-4o:2.5/10

# --- Stripe billing (PAY-04) ---
# Leave STRIPE_SECRET_KEY blank to disable billing (endpoints return 503; app
# still boots). Price IDs come from your Stripe dashboard (recurring prices).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_SCHOLAR_MONTHLY=
STRIPE_PRICE_SCHOLAR_ANNUAL=
# One-time credit packs (PAY-05) — non-expiring extra documents.
STRIPE_PRICE_CREDITS_5=
STRIPE_PRICE_CREDITS_10=
# The SPA origin Stripe redirects back to after checkout.
FRONTEND_BASE_URL=http://localhost:5173
