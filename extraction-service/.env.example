# Copy to .env and adjust. The service reads these on each run.

# LLM provider: ollama (local, default) | claude | openai
LLM_PROVIDER=ollama

# --- Ollama (LOCAL/LAN, default — no API key) -------------------------------
# Ollama server on the LAN host. qwen2.5:3b is fast (use CHUNK_TOKENS~600);
# qwen2.5:14b is higher quality but slower.
OLLAMA_BASE_URL=http://192.168.100.158:11434
OLLAMA_MODEL=qwen2.5:3b
# For a server on the same machine, use http://localhost:11434 instead.

# --- Claude (cloud, recommended for quality) --------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- OpenAI (cloud, alternative) --------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ingestion guardrails
MAX_FILE_BYTES=104857600   # 100 MB
MAX_PAGES=500
MIN_TEXT_CHARS=40

# Chunking (prose, token estimate). 600 suits the 3b model; raise to ~1200 for
# qwen2.5:14b or a cloud model.
CHUNK_TOKENS=600
CHUNK_OVERLAP=100

# Generate the executive Brief after building the graph (one extra LLM call).
GENERATE_BRIEF=true

# --- Auth + DB (Sprint 1a) ---
# In Docker, docker-compose sets DATABASE_URL to the `db` service. For local runs:
# DATABASE_URL=postgresql+psycopg2://kb:kb@localhost:5432/kb
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
# Refresh cookie is HttpOnly always. In production (HTTPS) set COOKIE_SECURE=true.
COOKIE_SECURE=false         # true = only sent over HTTPS (production)
COOKIE_SAMESITE=lax         # lax (same-site) | none (cross-site; auto-forces Secure)
# First admin (seeded only when the users table is empty):
ADMIN_EMAIL=admin@knowledgebook.local
ADMIN_PASSWORD=admin12345

# --- Subscription plans (PAY-01/02/03) ---
# Monthly document quota per consumer plan (0 = unlimited). Admins are exempt.
PLAN_FREE_DOCS=2
PLAN_PRO_DOCS=20
PLAN_SCHOLAR_DOCS=60
# Concept-map cap on the Free tier (0 = uncapped).
PLAN_FREE_CONCEPTS=10

# --- Cost ledger + cap (EXT-02) ---
# Per-document hard cost cap in USD (0 = disabled). Local/free models accrue $0.
MAX_DOC_COST_USD=2.0
# Optional price override, USD per 1M tokens: model:in/out,model:in/out
# LLM_PRICES_USD=claude-opus-4-8:15/75,gpt-4o:2.5/10

# --- Stripe billing (PAY-04) ---
# Leave STRIPE_SECRET_KEY blank to disable billing (endpoints return 503; app
# still boots). Price IDs come from your Stripe dashboard (recurring prices).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_SCHOLAR_MONTHLY=
STRIPE_PRICE_SCHOLAR_ANNUAL=
# The SPA origin Stripe redirects back to after checkout.
FRONTEND_BASE_URL=http://localhost:5173
